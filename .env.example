# FTP-Zugangsdaten für "npm run deploy"
# Diese Datei nach ".env" kopieren und die echten Werte eintragen.
# Die .env ist per .gitignore ausgeschlossen und landet NICHT auf GitHub.

# Servername, so wie in FileZilla unter "Server" / "Host" eingetragen
FTP_HOST=w01d9c71.kasserver.com

# Benutzername und Passwort, wie in FileZilla
FTP_USER=f0155cfd
FTP_PASSWORD=%MikaFinn!Privat12

# Zielordner auf dem Server (dorthin, wo die Webseite liegt),
# z.B. / oder /html oder /public_html
FTP_REMOTE_DIR=/

# Verschlüsselte Verbindung (FTPS). Auf "false" setzen, falls der
# Server nur unverschlüsseltes FTP unterstützt.
FTP_SECURE=true

# Nur ändern, falls dein Server einen anderen Port nutzt
FTP_PORT=21
